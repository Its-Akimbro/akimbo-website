---
// The layout for the legal pages: title, effective date, the draft notice
// and readable long-form text. Each page supplies its own sections.
import BaseLayout from "./BaseLayout.astro";
import { LEGAL_EFFECTIVE_DATE } from "../site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const effectiveDate = new Date(`${LEGAL_EFFECTIVE_DATE}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={title} description={description}>
  <article
    class="mx-auto max-w-3xl px-4 py-12 sm:px-6 [&_a]:text-blue [&_a]:underline [&_a:hover]:text-blue-dark [&_h2]:mt-10 [&_h3]:mt-6 [&_li]:mt-2 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6"
  >
    <h1>{title}</h1>
    <p class="text-muted">
      Effective date: <time datetime={LEGAL_EFFECTIVE_DATE}>{effectiveDate}</time>
    </p>
    <aside
      aria-label="Draft notice"
      class="mt-6 rounded border border-slate-200 bg-slate-50 px-4 py-3 [&_p]:mt-0"
    >
      <p>
        <strong>Draft pending attorney review.</strong> This page has not yet been reviewed by a
        lawyer and may change before it is final.
      </p>
    </aside>
    <slot />
  </article>
</BaseLayout>
