---
import { Image } from "astro:assets";
import lockup from "../../../brand/lockup-colour-for-dark-bg.png";
import AuditCta from "./AuditCta.astro";
import { NAV, PORTAL_URL, SITE_NAME } from "../site";
---

<header class="bg-navy text-white">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6"
  >
    <a href="/" class="shrink-0 focus-visible:outline-2 focus-visible:outline-white">
      <Image src={lockup} alt={SITE_NAME} width={200} densities={[1, 2]} class="h-auto w-40 sm:w-50" loading="eager" />
    </a>
    {
      NAV.length > 0 && (
        <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
            {NAV.map((item) => (
              <li>
                <a href={item.href} class="text-white hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="flex w-full items-center justify-between gap-4 sm:w-auto sm:justify-end">
      <a href={PORTAL_URL} class="text-sm font-medium text-white hover:underline">Log in</a>
      <AuditCta />
    </div>
  </div>
</header>
