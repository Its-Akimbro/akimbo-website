---
// The Book an audit form. A plain HTML form that works without JavaScript:
// it posts urlencoded to the Marketing Worker (ADR 0003). The page that uses
// it loads the Turnstile script once.
import {
  CONTACT_ENDPOINT,
  DEVICE_COUNTS,
  HONEYPOT_FIELD,
  MAX_LENGTH,
  TURNSTILE_SITE_KEY,
} from "../contact-form";
import { AUDIT, count, formatUsd } from "../pricing";

const input =
  "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-navy focus-visible:border-blue focus-visible:ring-2 focus-visible:ring-blue focus-visible:outline-none";
const label = "block font-medium";
const optional = "font-normal text-muted";
---

<form
  method="post"
  action={CONTACT_ENDPOINT}
  aria-labelledby="audit-heading"
  class="max-w-xl space-y-5"
>
  <h2 id="audit-heading">Book an audit</h2>
  <p class="text-muted">
    Tell us about the site and we'll reply within one business day to agree a date.
  </p>

  <input type="hidden" name="kind" value="audit" />
  {/* The service page the visitor came from. The contact page script (#40) fills it from `?service=`. */}
  <input type="hidden" name="service" value="" />

  <div>
    <label for="audit-name" class={label}>Name</label>
    <input
      id="audit-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength={MAX_LENGTH.name}
      class={input}
    />
  </div>

  <div>
    <label for="audit-business" class={label}>Business name</label>
    <input
      id="audit-business"
      name="business"
      type="text"
      autocomplete="organization"
      required
      maxlength={MAX_LENGTH.business}
      class={input}
    />
  </div>

  <div>
    <label for="audit-email" class={label}>Email</label>
    <input
      id="audit-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength={MAX_LENGTH.email}
      class={input}
    />
  </div>

  <div>
    <label for="audit-phone" class={label}>
      Phone <span class={optional}>(optional)</span>
    </label>
    <input
      id="audit-phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      maxlength={MAX_LENGTH.phone}
      class={input}
    />
  </div>

  <div>
    <label for="audit-town" class={label}>Site town or city</label>
    <input
      id="audit-town"
      name="town"
      type="text"
      autocomplete="address-level2"
      required
      maxlength={MAX_LENGTH.town}
      class={input}
    />
  </div>

  <div>
    <label for="audit-devices" class={label}>Approximate number of infrastructure devices</label>
    <p id="audit-devices-hint" class="mt-1 text-sm text-muted">
      Switches, routers, firewalls, wireless access points and servers. Don't count PCs, phones or
      printers.
    </p>
    <select
      id="audit-devices"
      name="devices"
      required
      aria-describedby="audit-devices-hint audit-devices-note"
      class={input}
    >
      <option value="">Choose one</option>
      {Object.entries(DEVICE_COUNTS).map(([value, text]) => <option value={value}>{text}</option>)}
    </select>
    <p id="audit-devices-note" class="mt-2 text-sm">
      The standard audit covers up to {AUDIT.maxDevices} infrastructure devices at {count(AUDIT.sites, "site", "sites")}. If
      yours has more than {AUDIT.maxDevices}, it's outside the standard audit and we'll quote the
      add-on, from {formatUsd(AUDIT.addOnFrom)}.
    </p>
  </div>

  <div>
    <label for="audit-timing" class={label}>
      Preferred timing <span class={optional}>(optional)</span>
    </label>
    <input
      id="audit-timing"
      name="timing"
      type="text"
      maxlength={MAX_LENGTH.timing}
      placeholder="For example, weekday mornings next month"
      class={input}
    />
  </div>

  <div>
    <label for="audit-notes" class={label}>
      Notes <span class={optional}>(optional)</span>
    </label>
    <textarea id="audit-notes" name="notes" rows="4" maxlength={MAX_LENGTH.notes} class={input}
    ></textarea>
  </div>

  {/* Honeypot: hidden from people and screen readers; bots fill it in. */}
  <div aria-hidden="true" class="absolute -left-[10000px] h-px w-px overflow-hidden">
    <label for="audit-website">Leave this field empty</label>
    <input id="audit-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>

  <div>
    <button
      type="submit"
      class="inline-flex min-h-11 items-center justify-center rounded-md bg-blue px-5 py-2 font-semibold text-white hover:bg-blue-dark focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Request an audit
    </button>
    <p class="mt-3 text-sm text-muted">
      We use your details only to reply and to scope the audit. See our <a
        href="/privacy/"
        class="text-blue underline hover:text-blue-dark">Privacy Policy</a
      >.
    </p>
  </div>
</form>
