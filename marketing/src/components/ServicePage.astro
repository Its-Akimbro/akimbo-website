---
// The shared service-page template: what's included, who it is and isn't
// for, a pointer to pricing, and the closing audit CTA.
import BaseLayout from "../layouts/BaseLayout.astro";
import AuditCta from "./AuditCta.astro";
import type { ServicePageContent } from "../service-pages";
import { contactHref, SERVICES } from "../services";

interface Props {
  page: ServicePageContent;
}

const { page } = Astro.props;
const { name } = SERVICES[page.slug];
---

<BaseLayout title={name} description={page.summary}>
  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h1>{name}</h1>
      <p class="mt-4 max-w-2xl text-lg">{page.summary}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl space-y-12 px-4 py-12 sm:px-6">
    <section aria-labelledby="included">
      <h2 id="included">What's included</h2>
      <ul class="mt-4 grid list-disc gap-2 pl-5 sm:grid-cols-2 sm:gap-x-10">
        {page.included.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="fit" class="grid gap-8 sm:grid-cols-2">
      <h2 id="fit" class="sr-only">Who it's for</h2>
      <div class="rounded-lg border border-slate-200 p-6">
        <h3>A good fit if…</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          {page.forYou.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-lg border border-slate-200 p-6">
        <h3>Not the right fit if…</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          {page.notForYou.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="pricing">
      <h2 id="pricing">Pricing</h2>
      <p class="mt-4 max-w-3xl">{page.pricing}</p>
      <p class="mt-4">
        <a href="/plans/" class="font-semibold text-blue underline hover:text-blue-dark">See Plans and prices</a>
      </p>
    </section>
  </div>

  <section aria-labelledby="start" class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 id="start">Every plan starts with an audit</h2>
      <p class="mt-4 max-w-3xl">
        We document what you actually have, then quote on it. The report is yours to keep, whether or not you hire us.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <AuditCta />
        <a href={contactHref(page.slug)} class="font-semibold text-blue underline hover:text-blue-dark">
          Or ask a question about {name.toLowerCase()}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
