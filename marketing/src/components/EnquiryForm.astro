---
// The General enquiry form. A plain HTML form that works without JavaScript:
// it posts urlencoded to the Marketing Worker (ADR 0003). The page that uses
// it loads the Turnstile script once.
import {
  CONTACT_ENDPOINT,
  HONEYPOT_FIELD,
  MAX_LENGTH,
  TURNSTILE_SITE_KEY,
} from "../contact-form";
import { SERVICES } from "../services";

const input =
  "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-navy focus-visible:border-blue focus-visible:ring-2 focus-visible:ring-blue focus-visible:outline-none";
const label = "block font-medium";
const optional = "font-normal text-muted";
---

<form
  method="post"
  action={CONTACT_ENDPOINT}
  aria-labelledby="enquiry-heading"
  class="max-w-xl space-y-5"
>
  <h2 id="enquiry-heading">General enquiry</h2>
  <p class="text-muted">Ask us anything. We reply within one business day.</p>

  <input type="hidden" name="kind" value="enquiry" />

  <div>
    <label for="enquiry-name" class={label}>Name</label>
    <input
      id="enquiry-name"
      name="name"
      type="text"
      autocomplete="name"
      required
      maxlength={MAX_LENGTH.name}
      class={input}
    />
  </div>

  <div>
    <label for="enquiry-email" class={label}>Email</label>
    <input
      id="enquiry-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      maxlength={MAX_LENGTH.email}
      class={input}
    />
  </div>

  <div>
    <label for="enquiry-business" class={label}>
      Business name <span class={optional}>(optional)</span>
    </label>
    <input
      id="enquiry-business"
      name="business"
      type="text"
      autocomplete="organization"
      maxlength={MAX_LENGTH.business}
      class={input}
    />
  </div>

  <div>
    <label for="enquiry-service" class={label}>
      Service <span class={optional}>(optional)</span>
    </label>
    <select id="enquiry-service" name="service" class={input}>
      <option value="">Not sure, or something else</option>
      {
        Object.entries(SERVICES).map(([slug, service]) => (
          <option value={slug}>{service.name}</option>
        ))
      }
    </select>
  </div>

  <div>
    <label for="enquiry-message" class={label}>Message</label>
    <textarea
      id="enquiry-message"
      name="message"
      rows="6"
      required
      maxlength={MAX_LENGTH.message}
      class={input}></textarea>
  </div>

  {/* Honeypot: hidden from people and screen readers; bots fill it in. */}
  <div aria-hidden="true" class="absolute -left-[10000px] h-px w-px overflow-hidden">
    <label for="enquiry-website">Leave this field empty</label>
    <input id="enquiry-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>

  <div>
    <button
      type="submit"
      class="inline-flex min-h-11 items-center justify-center rounded-md bg-blue px-5 py-2 font-semibold text-white hover:bg-blue-dark focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Send enquiry
    </button>
    <p class="mt-3 text-sm text-muted">
      We use your details only to reply. See our <a
        href="/privacy/"
        class="text-blue underline hover:text-blue-dark">Privacy Policy</a
      >.
    </p>
  </div>
</form>
