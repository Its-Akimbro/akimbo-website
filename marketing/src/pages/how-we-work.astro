---
import AuditCta from "../components/AuditCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const principles = [
  {
    title: "Documented first",
    body: [
      "We write things down as we go, not at the end of a project or when someone asks. Every device, circuit, IP range and VLAN we manage is recorded, and the record is updated when we change something.",
      "If we're unavailable, the next engineer (ours or anyone else's) can find what they need without guessing.",
    ],
  },
  {
    title: "No hostage-taking",
    body: [
      "Your network documentation, configurations and admin credentials belong to you. We never hold them back to keep your business.",
      "Plans are month-to-month with no exit fee. If you leave, we hand everything over and brief your next provider. Leaving should be boring.",
    ],
  },
  {
    title: "Plain English",
    body: [
      "Reports, findings and quotes are written for the person who runs the business, not for another engineer. Each recommendation says what the risk is, what fixing it costs, and what happens if you wait.",
      "When there's a trade-off, we explain it and you decide.",
    ],
  },
];

const documented = [
  { what: "Sites", detail: "each location we look after, with its address and areas" },
  { what: "Racks and devices", detail: "make, model, serial, firmware and status of every switch, router, firewall and server" },
  { what: "Interfaces and IP addresses", detail: "on every device and virtual machine" },
  { what: "Virtual machines", detail: "what runs where" },
  { what: "Circuits", detail: "provider, circuit ID, type and speed, so you have them when you call your ISP" },
  { what: "IP ranges and VLANs", detail: "how your network is divided up" },
  { what: "Contacts", detail: "your own people and who to call about what" },
];
---

<BaseLayout
  title="How we work"
  description="Akimbo Technology documents everything first, never holds your documentation hostage and explains things in plain English. See what's in the Client Portal."
>
  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <h1>How we work</h1>
      <p class="mt-4 max-w-2xl text-lg">
        Three principles shape every job, from the first audit to the day-to-day running of your network.
      </p>
    </div>
  </section>

  <section aria-labelledby="principles" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="principles" class="sr-only">Our principles</h2>
    <ol class="grid gap-8 md:grid-cols-3">
      {
        principles.map((principle, i) => (
          <li class="rounded-lg border border-slate-200 bg-slate-50 p-6">
            <p class="font-heading text-sm font-semibold text-muted">{`0${i + 1}`}</p>
            <h3 class="mt-1">{principle.title}</h3>
            {principle.body.map((paragraph) => (
              <p class="mt-3">{paragraph}</p>
            ))}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="client-portal" class="border-t border-slate-200">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2">
      <div>
        <h2 id="client-portal">The Client Portal</h2>
        <p class="mt-4">
          Our documentation isn't locked in our own systems. Every client on a plan gets logins to the Client Portal,
          where you can look up anything we manage for you: what it is, where it is, and how it's set up.
        </p>
        <p class="mt-4">
          The portal is a reference, not a monitoring screen. It shows the same records our engineers work from, so
          what you see is what we see.
        </p>
        <h3 class="mt-8">It's yours to keep</h3>
        <p class="mt-3">
          The documentation is yours, not ours. If you leave, you get all of it, along with your configurations and
          admin credentials, at no charge.
        </p>
        <p class="mt-4">
          Starting with a network audit? Your device inventory comes with the audit report, and it goes live in the
          portal when you join a plan.
        </p>
      </div>
      <div>
        <h3>What's in the portal</h3>
        <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200">
          {
            documented.map((item) => (
              <li class="px-4 py-3">
                <span class="font-semibold">{item.what}</span>
                <span class="text-muted">: {item.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-12 sm:px-6">
      <h2>Every plan starts with an audit</h2>
      <p class="max-w-2xl">
        A fixed-price network audit gets your network documented and gives you a plain-English report that's yours to
        keep, whether or not you hire us.
      </p>
      <AuditCta />
    </div>
  </section>
</BaseLayout>
