---
// The contact page: the Book an audit and General enquiry forms. Without
// JavaScript both show, one after the other, and post as plain forms. The
// script below (#40) turns them into tabs and sends them in the page.
import AuditForm from "../components/AuditForm.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "../site";
---

<BaseLayout title="Contact" description="Book a network audit or ask Akimbo Technology a question.">
  {/* Turnstile is the only third-party script on the site, and only this page loads it. */}
  <script
    slot="head"
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1>Contact</h1>
    <p class="mt-4">
      Book a network audit or ask us a question using the forms below, or email <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="text-blue underline hover:text-blue-dark">{CONTACT_EMAIL}</a
      >.
    </p>

    {/* Each panel becomes a tab, named by its form's heading. */}
    <div
      data-contact-tabs
      class="relative mt-10 grid gap-16 data-tabbed:gap-8 lg:[&:not([data-tabbed])]:grid-cols-2"
    >
      <div id="audit-panel" data-tab-panel><AuditForm /></div>
      <div id="enquiry-panel" data-tab-panel><EnquiryForm /></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { enhanceContactPage } from "../contact-page";

  enhanceContactPage(document, {
    search: location.search,
    // Wrapped: the browser's fetch throws if called detached from window.
    fetch: (input, init) => fetch(input, init),
    resetTurnstile: (form) => {
      const widget = form.querySelector<HTMLElement>(".cf-turnstile");
      // Turnstile renders the widget itself (implicit rendering), so it is
      // named by its container. The script may not have loaded.
      if (widget) window.turnstile?.reset(widget);
    },
  });
</script>
