---
// The contact page: the Book an audit and General enquiry forms. Without
// JavaScript both show, one after the other; #40 turns them into tabs.
import AuditForm from "../components/AuditForm.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "../site";
---

<BaseLayout title="Contact" description="Book a network audit or ask Akimbo Technology a question.">
  {/* Turnstile is the only third-party script on the site, and only this page loads it. */}
  <script
    slot="head"
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1>Contact</h1>
    <p class="mt-4">
      Book a network audit or ask us a question using the forms below, or email <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="text-blue underline hover:text-blue-dark">{CONTACT_EMAIL}</a
      >.
    </p>

    <div class="relative mt-10 grid gap-16 lg:grid-cols-2">
      <AuditForm />
      <EnquiryForm />
    </div>
  </div>
</BaseLayout>
