---
// Stub until the contact forms land (#38, #39).
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL } from "../site";
---

<BaseLayout title="Contact" description="Book a network audit or ask Akimbo Technology a question.">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1>Contact</h1>
    <p class="mt-4">
      Email <a href={`mailto:${CONTACT_EMAIL}`} class="text-blue underline hover:text-blue-dark">{CONTACT_EMAIL}</a>.
    </p>
  </div>
</BaseLayout>
