---
import AuditCta from "../components/AuditCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CERTIFICATIONS, CITY_REGION, FOUNDER_NAME, FOUNDER_PHOTO, YEARS_OF_EXPERIENCE } from "../placeholders";
import { AUDIT, formatUsd } from "../pricing";
import { SERVICE_SUMMARIES } from "../service-summaries";
import { AUDIT_CTA } from "../site";

const steps = [
  {
    title: "Audit",
    body: "We document the network devices at your site (firewalls, switches, access points and servers) and walk you through a plain-English report of what we found. The report is yours to keep, whether or not you hire us.",
  },
  {
    title: "Fix",
    body: `Bigger fixes the audit turns up get a fixed-price quote, with no obligation, and smaller ones are billed by the hour. Sign a Plan, or a project quoted from the audit, within ${AUDIT.creditWindowDays} days and the full audit fee is credited.`,
  },
  {
    title: "Run",
    body: "A monthly Plan keeps it that way: monitored, updated and documented in the Client Portal.",
  },
];

const reasons = [
  {
    title: "Infrastructure specialists",
    body: "Networks, servers and virtualisation are all we do. No desktops, no help desk, so all of our attention goes on what keeps you connected.",
  },
  {
    title: "Everything documented, and visible to you",
    body: "Every device we manage is recorded and kept up to date in the Client Portal, where you can look it up any time. The documentation is yours to keep.",
  },
  {
    title: "Local and remote",
    body: `On site across ${CITY_REGION} when it's needed, and remote support wherever you are.`,
  },
];
---

<BaseLayout>
  <section class="bg-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h1 class="max-w-3xl text-display">Managed networks and servers for small businesses in {CITY_REGION}</h1>
      <p class="mt-5 max-w-2xl text-lg">
        Reliable Wi-Fi, secure firewalls, servers with backups checked, and documentation you can actually read. Start with a
        fixed-price audit so you know exactly what you've got.
      </p>
      <div class="mt-8">
        <AuditCta>{`${AUDIT_CTA.label} · ${formatUsd(AUDIT.price)}`}</AuditCta>
      </div>
    </div>
  </section>

  <section aria-labelledby="services" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="services">Services</h2>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        SERVICE_SUMMARIES.map((service) => (
          <li
            class:list={[
              "relative flex flex-col rounded-lg p-6",
              service.startHere ? "border-2 border-navy bg-slate-50" : "border border-slate-200",
            ]}
          >
            {service.startHere && (
              <p class="mb-2 text-sm font-semibold tracking-wide text-muted uppercase">Start here</p>
            )}
            <h3>
              <a href={service.href} class="text-navy after:absolute after:inset-0 hover:underline">
                {service.name}
              </a>
            </h3>
            <p class="mt-2">{service.tagline}</p>
            {service.startHere && <p class="mt-3 font-semibold">{service.billing}</p>}
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a href="/services/" class="font-semibold text-blue underline hover:text-blue-dark">Compare all services</a>
    </p>
  </section>

  <section aria-labelledby="how-it-works" class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 id="how-it-works">How it works</h2>
      <ol class="mt-6 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <p aria-hidden="true" class="font-heading text-sm font-semibold text-muted">{`0${i + 1}`}</p>
              <h3 class="mt-1">{step.title}</h3>
              <p class="mt-2">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8">
        <a href="/plans/" class="font-semibold text-blue underline hover:text-blue-dark">See Plans and prices</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="why-akimbo" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="why-akimbo">Why Akimbo</h2>
    <ul class="mt-6 grid gap-8 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <li class="rounded-lg border border-slate-200 p-6">
            <h3>{reason.title}</h3>
            <p class="mt-2">{reason.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a href="/how-we-work/" class="font-semibold text-blue underline hover:text-blue-dark">How we work</a>
    </p>
  </section>

  <section aria-labelledby="founder" class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-center sm:px-6">
      <div
        role="img"
        aria-label={FOUNDER_PHOTO}
        class="flex size-28 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white p-3 text-center text-xs text-muted"
      >
        <span aria-hidden="true">{FOUNDER_PHOTO}</span>
      </div>
      <div>
        <h2 id="founder" class="text-h3">Who you'll work with</h2>
        <p class="mt-2 max-w-3xl">
          Akimbo is run by {FOUNDER_NAME}, a network engineer with {YEARS_OF_EXPERIENCE} years of experience. When you
          call, you get the engineer who knows your network.
        </p>
        <p class="mt-2 text-sm text-muted">{CERTIFICATIONS.join(" · ")} · Month-to-month, no exit fee</p>
        <p class="mt-3">
          <a href="/about/" class="font-semibold text-blue underline hover:text-blue-dark">About Akimbo</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
