---
// Where the Worker sends a browser after a successful no-JS form post.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONFIRMATION } from "../../contact-form";
import { CONTACT_EMAIL } from "../../site";
---

<BaseLayout
  title={CONFIRMATION.heading}
  description="Your enquiry has reached Akimbo Technology."
  noindex
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1>{CONFIRMATION.heading}</h1>
    <p class="mt-4 max-w-xl">{CONFIRMATION.body}</p>
    <p class="mt-4 max-w-xl text-muted">
      Something urgent, or need to add anything? Email <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="text-blue underline hover:text-blue-dark">{CONTACT_EMAIL}</a
      >.
    </p>
  </div>
</BaseLayout>
