{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akimbo-marketing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Each `wrangler versions upload` from the release workflow gets a preview
  // URL, which the owner checks before approving promotion.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs before asset matching so it can redirect `www` to the
    // apex and, later, handle /api/contact.
    "run_worker_first": true
  },
  "vars": {
    "APEX_HOST": "akimbo.technology"
  }
}
